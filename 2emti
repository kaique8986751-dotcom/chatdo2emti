# Build corrected version by replacing only the JS section, preserving HTML/CSS.
from pathlib import Path
path=Path("/mnt/data/Texto colado(3).txt")
html=path.read_text(encoding="utf-8")
new_js=r'''<script>
  // =========================================================
  // TimeChat — P2P via PeerJS
  // ID persistente + reconexão robusta
  // =========================================================

  let peer = null;
  let conn = null;
  let inChat = false;          // PeerJS conectado ao servidor de sinalização
  let myPeerId = null;
  let connecting = false;
  let intentionalDisconnect = false;

  let peerReconnectTimer = null;
  let p2pReconnectTimer = null;
  let peerReconnectAttempts = 0;
  let p2pReconnectAttempts = 0;
  let connectionToken = 0;

  let remoteUser = {
    name: "Usuário",
    avatar: ""
  };

  const STORAGE_KEYS = {
    peerId: "timechat_peer_id",
    remoteId: "timechat_remote_id",
    avatar: "timechat_avatar",
    username: "timechat_username"
  };

  const DEFAULT_AVATAR =
    "https://api.dicebear.com/7.x/bottts/svg?seed=timechat";

  let userAvatarSrc =
    localStorage.getItem(STORAGE_KEYS.avatar) || DEFAULT_AVATAR;

  const statusEl = document.getElementById("status");
  const sessionBtn = document.getElementById("session-btn");
  const messagesEl = document.getElementById("messages");
  const inputEl = document.getElementById("message-input");
  const sendBtn = document.getElementById("send-btn");
  const imageInput = document.getElementById("image-file");
  const profileInput = document.getElementById("profile-file");
  const profilePreview = document.getElementById("profile-preview");
  const usernameInput = document.getElementById("username-input");
  const connectPanel = document.getElementById("connect-panel");
  const remoteIdInput = document.getElementById("remote-id-input");
  const connectBtn = document.getElementById("connect-btn");
  const myIdEl = document.getElementById("my-id");
  const imgBtnLabel = document.getElementById("img-btn-label");

  profilePreview.src = userAvatarSrc;

  const savedUsername = localStorage.getItem(STORAGE_KEYS.username);
  if (savedUsername) usernameInput.value = savedUsername;

  const savedRemoteId = localStorage.getItem(STORAGE_KEYS.remoteId);
  if (savedRemoteId) remoteIdInput.value = savedRemoteId;

  // ---------------------------------------------------------
  // ID permanente
  // ---------------------------------------------------------

  function generatePersistentPeerId() {
    const existing = localStorage.getItem(STORAGE_KEYS.peerId);

    if (existing && /^timechat-[a-z0-9-]+$/i.test(existing)) {
      return existing;
    }

    const randomPart = cryptoRandomId();
    const newId = "timechat-" + randomPart;

    localStorage.setItem(STORAGE_KEYS.peerId, newId);
    return newId;
  }

  function cryptoRandomId() {
    if (window.crypto && crypto.getRandomValues) {
      const bytes = new Uint32Array(3);
      crypto.getRandomValues(bytes);
      return Array.from(bytes)
        .map(n => n.toString(36))
        .join("")
        .slice(0, 18);
    }

    return (
      Math.random().toString(36).slice(2) +
      Date.now().toString(36)
    ).slice(0, 18);
  }

  const persistentPeerId = generatePersistentPeerId();

  // ---------------------------------------------------------
  // Utilitários
  // ---------------------------------------------------------

  function getCurrentTime() {
    return new Date().toLocaleTimeString("pt-BR", {
      hour: "2-digit",
      minute: "2-digit"
    });
  }

  function getUsername() {
    return usernameInput.value.trim().slice(0, 15) || "Usuário";
  }

  function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function addSystemMessage(text) {
    const msg = document.createElement("div");
    msg.className = "message system";
    msg.textContent = text;
    messagesEl.appendChild(msg);
    scrollToBottom();
  }

  function setStatus(text, online = false) {
    statusEl.textContent = text;
    statusEl.classList.toggle("online", online);
  }

  function saveRemoteId(id) {
    const value = (id || "").trim();
    if (value && value !== myPeerId) {
      localStorage.setItem(STORAGE_KEYS.remoteId, value);
    }
  }

  function enableInput() {
    inputEl.disabled = false;
    sendBtn.disabled = false;
    imageInput.disabled = false;
    imgBtnLabel.classList.remove("disabled");
  }

  function disableInput() {
    inputEl.disabled = true;
    sendBtn.disabled = true;
    imageInput.disabled = true;
    imgBtnLabel.classList.add("disabled");
  }

  function clearTimer(name) {
    if (name === "peer") {
      clearTimeout(peerReconnectTimer);
      peerReconnectTimer = null;
    } else {
      clearTimeout(p2pReconnectTimer);
      p2pReconnectTimer = null;
    }
  }

  function resetRemoteUser() {
    remoteUser = {
      name: "Usuário",
      avatar: ""
    };
  }

  // ---------------------------------------------------------
  // Perfil
  // ---------------------------------------------------------

  function triggerProfileUpload() {
    profileInput.click();
  }

  profileInput.addEventListener("change", event => {
    const file = event.target.files[0];
    if (!file) return;

    if (!file.type.startsWith("image/")) {
      addSystemMessage("Selecione uma imagem válida.");
      return;
    }

    const reader = new FileReader();

    reader.onload = e => {
      userAvatarSrc = e.target.result;
      profilePreview.src = userAvatarSrc;

      try {
        localStorage.setItem(STORAGE_KEYS.avatar, userAvatarSrc);
      } catch (error) {
        console.warn("Não foi possível salvar o avatar localmente.", error);
        addSystemMessage("A imagem é grande demais para ser salva localmente.");
      }

      if (conn && conn.open) {
        sendUserInfo(conn);
      }
    };

    reader.readAsDataURL(file);
    profileInput.value = "";
  });

  usernameInput.addEventListener("change", () => {
    usernameInput.value = getUsername();

    try {
      localStorage.setItem(STORAGE_KEYS.username, usernameInput.value);
    } catch (_) {}

    if (conn && conn.open) {
      sendUserInfo(conn);
    }
  });

  // ---------------------------------------------------------
  // PeerJS / sinalização
  // ---------------------------------------------------------

  function createPeer() {
    if (intentionalDisconnect || connecting) return;

    if (typeof Peer === "undefined") {
      setStatus("● PeerJS não carregou");
      addSystemMessage(
        "Não foi possível carregar o PeerJS. Verifique sua internet e recarregue a página."
      );
      return;
    }

    connecting = true;
    setStatus("● Conectando ao servidor...");

    try {
      peer = new Peer(persistentPeerId, {
        debug: 1,
        config: {
          iceServers: [
            { urls: "stun:stun.l.google.com:19302" },
            { urls: "stun:stun1.l.google.com:19302" }
          ]
        }
      });
    } catch (error) {
      console.error("Erro ao criar Peer:", error);
      connecting = false;
      schedulePeerRestart();
      return;
    }

    attachPeerEvents(peer);
  }

  function startPeer() {
    if (intentionalDisconnect) return;

    if (!peer) {
      createPeer();
      return;
    }

    if (peer.destroyed || peer.closed) {
      peer = null;
      myPeerId = null;
      inChat = false;
      createPeer();
      return;
    }

    if (peer.disconnected) {
      try {
        peer.reconnect();
        setStatus("● Reconectando ao servidor...");
      } catch (error) {
        console.error("Falha no peer.reconnect():", error);
        schedulePeerRestart();
      }
    }
  }

  function attachPeerEvents(peerInstance) {
    peerInstance.on("open", id => {
      if (peer !== peerInstance || intentionalDisconnect) return;

      myPeerId = id;
      inChat = true;
      connecting = false;
      peerReconnectAttempts = 0;
      clearTimer("peer");

      setStatus(
        conn && conn.open ? "● Conversando" : "● Online",
        true
      );

      sessionBtn.textContent = "Desconectar";
      sessionBtn.classList.remove("btn-enter");
      sessionBtn.classList.add("btn-leave");

      connectPanel.style.display = "flex";
      myIdEl.textContent = id;

      addSystemMessage("Você está online.");
      addSystemMessage("Seu ID permanente é: " + id);

      const lastRemoteId = localStorage.getItem(STORAGE_KEYS.remoteId);

      if (
        lastRemoteId &&
        lastRemoteId !== id &&
        !(conn && conn.open)
      ) {
        remoteIdInput.value = lastRemoteId;
        scheduleReconnect(true);
      }
    });

    peerInstance.on("connection", incoming => {
      if (peer !== peerInstance || intentionalDisconnect) {
        try { incoming.close(); } catch (_) {}
        return;
      }

      // Evita duas conexões simultâneas para o mesmo usuário.
      if (conn && conn.open) {
        if (incoming.peer === conn.peer) {
          try { incoming.close(); } catch (_) {}
        } else {
          try { incoming.close(); } catch (_) {}
          addSystemMessage(
            "Já existe uma conexão P2P ativa. A nova conexão foi recusada."
          );
        }
        return;
      }

      replaceConnection(incoming);
    });

    peerInstance.on("disconnected", () => {
      if (peer !== peerInstance || intentionalDisconnect) return;

      inChat = false;
      connecting = false;

      setStatus("● Reconectando servidor...", false);
      schedulePeerReconnect();
    });

    peerInstance.on("close", () => {
      if (peer !== peerInstance) return;

      const wasIntentional = intentionalDisconnect;

      peer = null;
      myPeerId = null;
      inChat = false;
      connecting = false;

      if (wasIntentional) return;

      setStatus("● Servidor desconectado", false);
      schedulePeerRestart();
    });

    peerInstance.on("error", error => {
      if (peer !== peerInstance || intentionalDisconnect) return;

      console.error("PeerJS:", error);
      connecting = false;

      switch (error.type) {
        case "peer-unavailable":
          connectBtn.disabled = false;
          addSystemMessage("Usuário não encontrado ou offline.");
          scheduleReconnect();
          break;

        case "unavailable-id":
          addSystemMessage(
            "Seu ID permanente já está sendo usado em outra aba ou dispositivo. " +
            "Feche a outra sessão antes de usar este mesmo ID."
          );
          setStatus("● ID já está em uso", false);
          break;

        case "network":
        case "socket-error":
        case "socket-closed":
        case "server-error":
          addSystemMessage(
            "Conexão com o servidor perdida. Tentando recuperar automaticamente..."
          );
          schedulePeerRestart();
          break;

        case "invalid-key":
          addSystemMessage("Configuração do servidor PeerJS inválida.");
          break;

        default:
          addSystemMessage(
            "Erro PeerJS: " +
            (error.message || error.type || "desconhecido")
          );
      }
    });
  }

  // ---------------------------------------------------------
  // Reconexão do servidor de sinalização
  // ---------------------------------------------------------

  function schedulePeerReconnect() {
    if (intentionalDisconnect || !peer || peer.destroyed) return;

    clearTimer("peer");

    const delay = Math.min(
      15000,
      1500 * Math.pow(2, Math.min(peerReconnectAttempts, 3))
    );

    peerReconnectAttempts++;

    peerReconnectTimer = setTimeout(() => {
      if (
        intentionalDisconnect ||
        !peer ||
        peer.destroyed ||
        peer.closed
      ) {
        return;
      }

      try {
        if (peer.disconnected) {
          peer.reconnect();
        } else if (!peer.open) {
          schedulePeerRestart();
        }
      } catch (error) {
        console.error("Erro ao reconectar PeerJS:", error);
        schedulePeerRestart();
      }
    }, delay);
  }

  function schedulePeerRestart() {
    if (intentionalDisconnect) return;

    clearTimer("peer");

    const delay = Math.min(
      15000,
      1500 * Math.pow(2, Math.min(peerReconnectAttempts, 4))
    );

    peerReconnectAttempts++;

    peerReconnectTimer = setTimeout(() => {
      if (intentionalDisconnect) return;

      const oldPeer = peer;

      if (oldPeer) {
        try { oldPeer.destroy(); } catch (_) {}
      }

      if (peer === oldPeer) {
        peer = null;
        myPeerId = null;
        inChat = false;
        connecting = false;
      }

      startPeer();
    }, delay);
  }

  // ---------------------------------------------------------
  // Sessão
  // ---------------------------------------------------------

  function toggleSession() {
    if (!inChat) {
      if (connecting) return;

      intentionalDisconnect = false;
      peerReconnectAttempts = 0;

      startPeer();
      return;
    }

    disconnectEverything();
  }

  function disconnectEverything(showMessage = true) {
    intentionalDisconnect = true;

    clearTimer("peer");
    clearTimer("p2p");

    closeCurrentConnection(false);

    const currentPeer = peer;

    peer = null;
    myPeerId = null;
    inChat = false;
    connecting = false;

    if (currentPeer) {
      try { currentPeer.destroy(); } catch (_) {}
    }

    resetRemoteUser();

    setStatus("● Fora do chat");

    sessionBtn.textContent = "Conectar Servidor";
    sessionBtn.classList.remove("btn-leave");
    sessionBtn.classList.add("btn-enter");

    connectPanel.style.display = "none";
    myIdEl.textContent = "";
    connectBtn.disabled = false;

    disableInput();

    if (showMessage) {
      addSystemMessage("Você saiu do chat.");
    }
  }

  // ---------------------------------------------------------
  // Conexão P2P
  // ---------------------------------------------------------

  function replaceConnection(newConnection) {
    closeCurrentConnection(false);

    conn = newConnection;
    const token = ++connectionToken;

    saveRemoteId(newConnection.peer);
    setupConnection(newConnection, token);
  }

  function closeCurrentConnection(resetUI = true) {
    if (conn) {
      try { conn.close(); } catch (_) {}
    }

    conn = null;
    resetRemoteUser();

    if (resetUI) {
      disableInput();
      connectBtn.disabled = false;
    }
  }

  function scheduleReconnect(immediate = false) {
    if (intentionalDisconnect) return;

    const remoteId = localStorage.getItem(STORAGE_KEYS.remoteId);

    if (
      !remoteId ||
      remoteId === myPeerId ||
      (conn && conn.open)
    ) {
      return;
    }

    clearTimer("p2p");

    const delay = immediate
      ? 1000
      : Math.min(
          20000,
          2000 * Math.pow(2, Math.min(p2pReconnectAttempts, 3))
        );

    p2pReconnectTimer = setTimeout(() => {
      reconnectToSavedPeer();
    }, delay);
  }

  function reconnectToSavedPeer() {
    if (intentionalDisconnect) return;

    const remoteId = localStorage.getItem(STORAGE_KEYS.remoteId);

    if (
      !remoteId ||
      remoteId === myPeerId ||
      (conn && conn.open)
    ) {
      return;
    }

    if (!peer || peer.destroyed || peer.disconnected || !inChat) {
      startPeer();
      scheduleReconnect();
      return;
    }

    remoteIdInput.value = remoteId;
    connectToPeer(true);
  }

  function connectToPeer(autoReconnect = false) {
    const remoteId = remoteIdInput.value.trim();

    if (!remoteId) {
      if (!autoReconnect) {
        addSystemMessage("Digite o código do outro usuário.");
      }
      return;
    }

    if (!peer || !inChat || peer.destroyed) {
      if (!autoReconnect) {
        addSystemMessage(
          'Primeiro clique em "Conectar Servidor".'
        );
      }
      return;
    }

    if (remoteId === myPeerId) {
      addSystemMessage("Você não pode conectar consigo mesmo.");
      return;
    }

    if (conn && (conn.open || conn._open)) {
      if (!autoReconnect) {
        addSystemMessage("Você já está conectado.");
      }
      return;
    }

    saveRemoteId(remoteId);
    clearTimer("p2p");
    connectBtn.disabled = true;

    if (!autoReconnect) {
      addSystemMessage("Conectando ao usuário...");
    }

    let newConn;

    try {
      newConn = peer.connect(remoteId, {
        reliable: true,
        serialization: "json"
      });

      replaceConnection(newConn);
    } catch (error) {
      console.error("peer.connect:", error);

      connectBtn.disabled = false;

      if (!autoReconnect) {
        addSystemMessage("Não foi possível iniciar a conexão.");
      }

      p2pReconnectAttempts++;
      scheduleReconnect();
    }
  }

  function setupConnection(connection, token) {
    if (!connection) return;

    connection.on("open", () => {
      if (token !== connectionToken || conn !== connection) return;

      connectBtn.disabled = false;
      p2pReconnectAttempts = 0;

      saveRemoteId(connection.peer);

      setStatus(
        "● Conectado com " + connection.peer,
        true
      );

      enableInput();
      addSystemMessage("Conexão P2P estabelecida!");

      sendUserInfo(connection);
    });

    connection.on("data", data => {
      if (token !== connectionToken || conn !== connection) return;
      if (!data || typeof data !== "object") return;

      if (data.type === "user-info") {
        remoteUser = {
          name: String(data.senderName || "Usuário").slice(0, 15),
          avatar: typeof data.avatarSrc === "string"
            ? data.avatarSrc
            : ""
        };

        setStatus(
          "● Conversando com " + remoteUser.name,
          true
        );
        return;
      }

      if (data.type === "message") {
        createMessageElement(
          typeof data.text === "string" ? data.text : "",
          "received",
          data.senderName || remoteUser.name || "Usuário",
          data.avatarSrc || remoteUser.avatar || DEFAULT_AVATAR,
          null,
          data.timestamp
        );
        return;
      }

      if (data.type === "image") {
        if (
          typeof data.chatImageSrc !== "string" ||
          !data.chatImageSrc.startsWith("data:image/")
        ) {
          return;
        }

        createMessageElement(
          "",
          "received",
          data.senderName || remoteUser.name || "Usuário",
          data.avatarSrc || remoteUser.avatar || DEFAULT_AVATAR,
          data.chatImageSrc,
          data.timestamp
        );
      }
    });

    connection.on("close", () => {
      if (token !== connectionToken || conn !== connection) return;

      conn = null;
      disableInput();
      connectBtn.disabled = false;
      resetRemoteUser();

      if (inChat) {
        setStatus("● Online", true);
      } else {
        setStatus("● Fora do chat", false);
      }

      if (!intentionalDisconnect) {
        p2pReconnectAttempts++;
        addSystemMessage(
          "A conexão foi encerrada. Tentando reconectar..."
        );
        scheduleReconnect();
      }
    });

    connection.on("error", error => {
      if (token !== connectionToken || conn !== connection) return;

      console.error("DataConnection:", error);

      conn = null;
      disableInput();
      connectBtn.disabled = false;

      if (!intentionalDisconnect) {
        p2pReconnectAttempts++;
        addSystemMessage(
          "Erro na conexão com o usuário. Tentando novamente..."
        );
        scheduleReconnect();
      }
    });
  }

  function sendUserInfo(connection) {
    if (!connection || !connection.open) return;

    try {
      connection.send({
        type: "user-info",
        senderName: getUsername(),
        avatarSrc: userAvatarSrc
      });
    } catch (error) {
      console.error("sendUserInfo:", error);
    }
  }

  // ---------------------------------------------------------
  // Mensagens
  // ---------------------------------------------------------

  function sendMessage() {
    const text = inputEl.value.trim();

    if (!text) return;

    if (!conn || !conn.open) {
      addSystemMessage(
        "Você não está conectado a outro usuário."
      );
      return;
    }

    const payload = {
      type: "message",
      senderName: getUsername(),
      avatarSrc: userAvatarSrc,
      text,
      timestamp: getCurrentTime()
    };

    try {
      conn.send(payload);

      createMessageElement(
        text,
        "sent",
        payload.senderName,
        payload.avatarSrc,
        null,
        payload.timestamp
      );

      inputEl.value = "";
      inputEl.focus();
    } catch (error) {
      console.error("sendMessage:", error);
      addSystemMessage(
        "Não foi possível enviar a mensagem."
      );
    }
  }

  // ---------------------------------------------------------
  // Imagens
  // ---------------------------------------------------------

  function resizeImage(file, maxWidth = 1000) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();

      reader.onload = event => {
        const img = new Image();

        img.onload = () => {
          let width = img.width;
          let height = img.height;

          if (width > maxWidth) {
            const ratio = maxWidth / width;
            width = maxWidth;
            height = Math.round(height * ratio);
          }

          const canvas = document.createElement("canvas");
          canvas.width = width;
          canvas.height = height;

          const ctx = canvas.getContext("2d");

          if (!ctx) {
            reject(new Error("Canvas não disponível."));
            return;
          }

          ctx.drawImage(img, 0, 0, width, height);

          resolve(canvas.toDataURL("image/jpeg", 0.65));
        };

        img.onerror = () =>
          reject(new Error("Não foi possível ler a imagem."));

        img.src = event.target.result;
      };

      reader.onerror = () =>
        reject(new Error("Não foi possível ler o arquivo."));

      reader.readAsDataURL(file);
    });
  }

  async function sendImage(event) {
    const file = event.target.files[0];
    event.target.value = "";

    if (!file) return;

    if (!file.type.startsWith("image/")) {
      addSystemMessage("Selecione uma imagem válida.");
      return;
    }

    if (!conn || !conn.open) {
      addSystemMessage("Você não está conectado.");
      return;
    }

    try {
      addSystemMessage("Preparando imagem...");

      const imageSrc = await resizeImage(file);

      if (!conn || !conn.open) {
        addSystemMessage(
          "A conexão caiu enquanto a imagem era preparada."
        );
        return;
      }

      const payload = {
        type: "image",
        senderName: getUsername(),
        avatarSrc: userAvatarSrc,
        chatImageSrc: imageSrc,
        timestamp: getCurrentTime()
      };

      conn.send(payload);

      createMessageElement(
        "",
        "sent",
        payload.senderName,
        payload.avatarSrc,
        imageSrc,
        payload.timestamp
      );
    } catch (error) {
      console.error("sendImage:", error);
      addSystemMessage(
        "Não foi possível enviar a imagem."
      );
    }
  }

  // ---------------------------------------------------------
  // Renderização
  // ---------------------------------------------------------

  function createMessageElement(
    text,
    type,
    senderName,
    avatarSrc,
    chatImageSrc = null,
    timeStr = null
  ) {
    const wrapper = document.createElement("div");
    wrapper.className = "message-wrapper " + type;

    const avatar = document.createElement("img");
    avatar.className = "msg-avatar";
    avatar.src = avatarSrc || DEFAULT_AVATAR;
    avatar.alt = "Avatar de " + (senderName || "Usuário");
    avatar.onerror = () => {
      avatar.src = DEFAULT_AVATAR;
    };

    wrapper.appendChild(avatar);

    const msg = document.createElement("div");
    msg.className = "message";

    const nameSpan = document.createElement("span");
    nameSpan.className = "sender-name";
    nameSpan.textContent = senderName || "Usuário";
    msg.appendChild(nameSpan);

    if (chatImageSrc) {
      const img = document.createElement("img");
      img.className = "chat-image";
      img.src = chatImageSrc;
      img.alt = "Imagem enviada";
      img.loading = "lazy";
      msg.appendChild(img);
    }

    if (text) {
      const textSpan = document.createElement("span");
      textSpan.textContent = text;
      msg.appendChild(textSpan);
    }

    const timeSpan = document.createElement("span");
    timeSpan.className = "timestamp";
    timeSpan.textContent = timeStr || getCurrentTime();
    msg.appendChild(timeSpan);

    wrapper.appendChild(msg);
    messagesEl.appendChild(wrapper);

    scrollToBottom();
  }

  // ---------------------------------------------------------
  // Eventos
  // ---------------------------------------------------------

  sessionBtn.addEventListener("click", toggleSession);

  connectBtn.addEventListener("click", () => {
    p2pReconnectAttempts = 0;
    connectToPeer(false);
  });

  sendBtn.addEventListener("click", sendMessage);
  imageInput.addEventListener("change", sendImage);

  inputEl.addEventListener("keydown", event => {
    if (event.key === "Enter" && !event.shiftKey) {
      event.preventDefault();
      sendMessage();
    }
  });

  remoteIdInput.addEventListener("input", () => {
    const id = remoteIdInput.value.trim();

    if (id && id !== myPeerId) {
      saveRemoteId(id);
    }
  });

  remoteIdInput.addEventListener("keydown", event => {
    if (event.key === "Enter") {
      event.preventDefault();
      p2pReconnectAttempts = 0;
      connectToPeer(false);
    }
  });

  // ---------------------------------------------------------
  // Recuperação de rede
  // ---------------------------------------------------------

  window.addEventListener("online", () => {
    if (intentionalDisconnect) return;

